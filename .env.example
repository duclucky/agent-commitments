# Local development only. Never put private keys in public client variables.
DATABASE_URL=postgres://agent_commitments:agent_commitments@localhost:5432/agent_commitments
TEST_DATABASE_URL=postgres://agent_commitments:agent_commitments@localhost:5432/agent_commitments
# Native Windows fallback installed by the local setup uses port 55432.
# TEST_DATABASE_URL=postgres://agent_commitments:agent_commitments@localhost:55432/agent_commitments_test
ARC_RPC_URL=
ARC_CHAIN_ID=5042
AUTH_AUDIENCE=agent-commitments.local
# Public deployment inputs only. Signers/keys belong in an external wallet or encrypted keystore.
TOKEN_ADDRESS=0x3600000000000000000000000000000000000000
ESCROW_ADDRESS=
OWNER_ADDRESS=
ROOT_EXPIRES_AT=
DEPOSIT_CAP=
MAX_COMMITMENT_AMOUNT=
MAX_CONCURRENT_COMMITMENTS=
