{
  "name": "@agent-commitments/sdk",
  "version": "0.1.0-alpha.2",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./resolvesignal-node-store": {
      "types": "./dist/resolvesignal-node-store.d.ts",
      "import": "./dist/resolvesignal-node-store.js"
    },
    "./resolvesignal-node": {
      "types": "./dist/resolvesignal-node.d.ts",
      "import": "./dist/resolvesignal-node.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "pretest": "pnpm --filter @agent-commitments/network-config build",
    "test": "vitest run --exclude \"dist/**\"",
    "pretypecheck": "pnpm --filter @agent-commitments/network-config build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agent-commitments/network-config": "workspace:*",
    "viem": "2.57.4"
  }
}
