{
  "name": "@agent-commitments/sdk",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "exports": { ".": "./dist/index.js" },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "pretest": "pnpm --filter @agent-commitments/network-config build",
    "test": "vitest run --exclude dist/**",
    "pretypecheck": "pnpm --filter @agent-commitments/network-config build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agent-commitments/network-config": "workspace:*",
    "viem": "2.57.4"
  }
}
