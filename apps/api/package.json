{
  "name": "@agent-commitments/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": { ".": "./dist/server.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx src/main.ts",
    "test": "vitest run --exclude dist/** --exclude src/postgres.integration.test.ts",
    "test:integration": "vitest run src/postgres.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "pg": "8.16.3",
    "viem": "2.57.4",
    "zod": "4.6.5"
  },
  "devDependencies": { "@types/pg": "8.15.5" }
}
